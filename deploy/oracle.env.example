# Copie para .env na raiz do projeto e preencha.
# O docker-compose.yml define IS_HOSTED, STORAGE_PROVIDER e LOCAL_STORAGE_DIR.

DOMAIN=www.arquive.online
ROOT_DOMAIN=arquive.online
APP_BASE_URL=https://www.arquive.online

# Sessão/assinatura de URLs de arquivo. Use pelo menos 32 caracteres aleatórios.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Senha inicial do admin (só é usada se o banco ainda não tiver admin).
ADMIN_PASSWORD=troque-esta-senha

# Banco atual (Neon/Supabase). Use a URL direta (sem pooler) e mantenha DATABASE_SSL=true.
# Se usar Postgres local, defina DATABASE_SSL=false.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=true
# Opcional: no Neon o TLS é validado pela raiz pública do sistema. No Supabase,
# cole o certificado raiz em Base64 (Database Settings -> SSL Configuration).
SUPABASE_CA_CERT_B64=

# Cron diário (o endpoint exige Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=troque-por-outro-segredo

# Push/VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@arquive.online

# E-mail de redefinição (opcional)
RESEND_API_KEY=
MAIL_FROM=

# Google Drive (opcional; mantenha o mesmo client/redirect da produção)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Só para a migração única do Blob antigo. Remova depois.
BLOB_READ_WRITE_TOKEN=
