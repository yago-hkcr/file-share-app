# Copie para .env e preencha SOMENTE para a migração Blob → S3.
# Não use este arquivo como .env do Render; lá as variáveis são configuradas no painel.

DATABASE_URL_UNPOOLED=postgresql://usuario:senha@host:5432/banco
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=arquive-files
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_FORCE_PATH_STYLE=true

# Opcional: no Supabase, informe o CA. No Neon pode ficar vazio.
# SUPABASE_CA_CERT_B64=...
