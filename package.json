{
  "name": "file-share-app",
  "version": "1.0.0",
  "description": "File sharing web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js && node --check api/index.js",
    "local:install": "npm install && npm --prefix local-runtime install",
    "local:start": "node local-runtime/start.cjs",
    "test:visual": "node test/visual/responsive-audit.mjs",
    "test:visual:quick": "node test/visual/responsive-audit.mjs --quick",
    "test:visual:update": "node test/visual/responsive-audit.mjs --update-snapshots"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.0",
    "css-tree": "^3.2.1",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@vercel/cli-config": "^0.3.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "playwright": "^1.65.1"
  }
}
