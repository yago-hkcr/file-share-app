#!/bin/sh
# =============================================================================
# Pre-commit do FileShare — evita a reincidência da corrupção de 08/10/2026.
#
# Naquela data, um truncamento (provavelmente do OneDrive) deixou 36 arquivos
# com exatamente 1506 bytes e commits seguintes propagaram o dano para o
# master. Este hook bloqueia:
#   1. Os blobs já conhecidos como corrompidos;
#   2. Qualquer arquivo novo staged com exatamente 1506 bytes;
#   3. Arquivos .js staged com erro de sintaxe (node --check).
#
# Para forçar um commit legítimo:  git commit --no-verify
# =============================================================================

fail=0

# --- 1 + 2: tamanho e hash dos arquivos staged -------------------------------
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

# Hashes dos blobs corrompidos conhecidos (truncados em 1506 bytes).
KNOWN_BAD="066d7ac83e36e9fb5e8c89aab0f7f7ac78385539
68efcb7ef06c0861d075504555447d1e19d55b3c
841f8b4fc6e424e21cc5567eb3f9455f172ce2e3
