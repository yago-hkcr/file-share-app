e4bca6293bce7ca536aedd137fbe452967dcf805
5096514945714a076251123382d6b3fbc302f600"

oldIFS=$IFS
IFS='
'
for f in $files; do
  [ -f "$f" ] || continue
  blob=$(git rev-parse ":$f" 2>/dev/null)
  size=$(git cat-file -s ":$f" 2>/dev/null)

  if echo "$KNOWN_BAD" | grep -q "$blob"; then
    echo "✗ BLOQUEADO: '$f' e um blob corrompido conhecido (truncamento de 08/10/2026)." >&2
    echo "   Restaure o arquivo de um commit saudavel (ex.: git checkout e7975f1 -- \"$f\")" >&2
    fail=1
  elif [ "$size" = "1506" ]; then
    echo "✗ BLOQUEADO: '$f' tem exatamente 1506 bytes — assinatura do truncamento." >&2
    echo "   O arquivo parece cortado. Confira o conteudo antes de commitar." >&2
    fail=1
  fi
done
IFS=$oldIFS

# --- 3: sintaxe dos .js staged ----------------------------------------------
for f in $files; do
  case "$f" in
    *.js)
      if command -v node >/dev/null 2>&1; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/fs-precommit-XXXXXX.js" 2>/dev/null || echo "/tmp/fs-precommit-$$.js")
        git show ":$f" > "$tmp" 2>/dev/null || continue
        if ! node --check "$tmp" >/dev/null 2>&1; then
          echo "✗ ERRO de sintaxe em '$f':" >&2
          node --check "$tmp" 2>&1 | sed 's/^/   /' >&2
          fail=1
        fi
        rm -f "$tmp"
      fi
      ;;
  esac
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "Commit cancelado. Corrija os arquivos acima ou use 'git commit --no-verify' se tiver certeza." >&2
  exit 1
fi

exit 0
